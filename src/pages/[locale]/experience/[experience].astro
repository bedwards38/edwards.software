---
import type { ExperienceEntry } from "@/content.config";
import { getCollection, getEntry, render } from "astro:content";
import { useTranslations } from "@utils/utils.ts";
import Layout from "@layouts/Layout.astro";
import ExplanationLayout from "@layouts/ExplanationLayout.astro";
import Blockquote from "@components/content/Blockquote.astro";
import H2 from "@components/content/H2.astro";
import H3 from "@components/content/H3.astro";
import UnorderedList from "@components/content/UnorderedList.astro";
import ListItem from "@components/content/ListItem.astro";
import Anchor from "@components/content/Anchor.astro";

const { experience, locale = "en" } = Astro.params;
const entry: ExperienceEntry = await getEntry(
    "experience",
    `${locale}/experience/${experience}`,
)!;
if (!entry) return Astro.redirect(`/${locale}`);

const { t } = useTranslations(locale);
const { Content } = await render(entry);
---

<Layout
    title={`${t("site.experience.title")}/${experience} | ${t("site.title")}`}
    description={t("site.experience.description")}
    prompt={t("page.experience-explanation.prompt").replace(
        /\$\{experience\}/g,
        experience!,
    )}
    image="/images/opengraph/experience-explanation.png"
    breadcrumbs={[
        { path: `/${locale}/experience`, name: t("site.experience.title") },
    ]}
    locale={locale}
    prevPath={`/${locale}/experience`}
>
    <ExplanationLayout>
        <Content
            components={{
                blockquote: Blockquote,
                h2: H2,
                h3: H3,
                ul: UnorderedList,
                li: ListItem,
                a: Anchor,
            }}
        />
    </ExplanationLayout>
</Layout>
