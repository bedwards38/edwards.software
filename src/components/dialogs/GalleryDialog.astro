import type { ImageSchema } from "@/content.config";
import { useTranslations } from "@utils/utils.ts";
import DialogLayout from "@layouts/DialogLayout.astro";
import BackIcon from "@icons/BackIcon.astro";

interface Props {
    images: ImageSchema[];
    title: string;
    locale?: string;
}

const { images, title, locale = "en" } = Astro.props;
const { t } = useTranslations(locale);
const galleryId = `${title
    ?.toLowerCase()
    .replace(/(-)+/g, "")
    .replace(/(\s)+|(\.)+/g, "-")
    .replace(/(\[)+|(\])+/g, "")}-gallery`;

---

<DialogLayout
    title={`${title} ${t("dialog.gallery.label")}`}
    command="show_gallery"
    locale={locale}
>
    <div
        class="gallery-container"
        data-id={galleryId}
        data-images={JSON.stringify(images)}
    >
        <div class="gallery-title">
            <h2 class="mono typewriter cursor" data-content={title}></h2>
        </div>
        <div class="gallery-nav" role="tablist" aria-label="Gallery Navigation">
            <div class="nav-btn prev" aria-label="Previous image">
                <BackIcon />
            </div>
            {
                images.map((image, index) => (
                    <button
                        class="thumbnail"
                        data-index={index}
                        role="tab"
                        aria-label={`View image ${index + 1} of ${images.length}`}
                    >
                        <img
                            src={image.src}
                            alt={image.alt}
                            loading="lazy"
                            decoding="async"
                        />
                    </button>
                ))
            }
            <div class="nav-btn next" aria-label="Next image">
                <BackIcon />
            </div>
        </div>

        <div class="caption-container">
            <p class="caption mono"></p>
        </div>
        <div class="image-container">
            <div class="image-frame">
                <img src="" alt="" />
            </div>
        </div>
    </div>
</DialogLayout>

<style>
    .gallery-container {
        display: grid;
        grid-template-areas:
            "title"
            "nav"
            "caption"
            "image";
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        padding: 0.5rem;
    }

    .gallery-title {
        opacity: 0.8;
    }

    .gallery-title h2 {
        grid-area: title;
        margin-bottom: unset;
        font-size: 1.15rem;
        padding: 0rem 1rem;
    }

    .gallery-nav {
        grid-area: nav;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        align-items: center;
        overflow-x: auto;
        padding: 1rem 1rem 0.5rem;
        max-width: 100%;
    }

    .nav-btn {
        display: none;
    }

    .nav-btn.next {
        transform: scaleX(-1);
    }

    .thumbnail {
        flex-shrink: 0;
        width: 60px;
        height: 60px;
        border: 2px solid var(--border);
        border-radius: 0.3125rem;
        background: transparent;
        cursor: pointer;
        padding: 0;
        transition: border-color 0.2s;
    }

    .thumbnail:hover {
        border-color: var(--earth);
        box-shadow: 3px 3px 5px rgb(from var(--accent) r g b / 15%);
    }

    .thumbnail.active {
        border-color: var(--earth-hover);
        box-shadow: 3px 3px 5px rgb(from var(--accent) r g b / 15%);
    }

    .thumbnail.active img {
        opacity: 1;
    }

    .thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 0.3s ease;
        border-radius: 0.3125rem;
        border: 1px solid var(--bg);
        background: var(--bg);
        opacity: 0.8;
    }

    .caption-container {
        grid-area: caption;
        display: flex;
        justify-content: center;
        text-align: center;
        width: 100%;
        padding: 0rem 0.5rem;
        min-height: 3.25rem;
        font-size: clamp(0.9rem, 3vw, 1em);
        opacity: 0.8;
    }

    .caption {
        margin-bottom: 0rem;
        align-content: center;
    }

    .image-container {
        grid-area: image;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.8;
    }

    .image-frame {
        border: 5px solid var(--border);
        border-radius: 0.675rem;
        box-shadow: 3px 3px 5px rgb(from var(--accent) r g b / 15%);
        background: var(--border);
        overflow: hidden;
        display: flex;
    }

    .image-container img {
        max-width: 100%;
        max-height: calc(100vh - 330px);
        transition: opacity 0.15s ease;
    }

    [data-theme="dark"] .image-frame {
        box-shadow: none;
    }

    @media (min-width: 880px) {
        .gallery-title h2 {
            margin-right: 1rem;
            font-size: 1.25rem;
        }

        .gallery-container {
            padding: 1rem 2rem;
        }

        .nav-btn {
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            color: var(--text);
            opacity: 0.5;
            transition: opacity 0.3s, transform 0.3s;
            width: clamp(1.75rem, 4vw, 2.5rem);
            height: clamp(1.75rem, 4vw, 2.5rem);
        }

        .nav-btn:hover {
            transform: translateY(-2px);
            opacity: 0.65;
            color: var(--earth-hover);
        }

        .nav-btn.next {
            transform: scaleX(-1);
        }

        .nav-btn.next:hover {
            transform: translateY(-2px) scaleX(-1);
            transition: opacity 0.3s, transform 0.3s;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
        }

        .image-frame {
            max-width: 95%;
        }
    }
</style>

<script>
    import type { ImageSchema } from "@/content.config";
    import { typewriter } from "@utils/utils";

    if (typeof document !== "undefined") document.addEventListener("astro:page-load", () => {
        document.querySelectorAll(".gallery-container").forEach((gallery) => {
            if (!gallery) return;

            const galleryElement: HTMLElement = gallery as HTMLElement;

            let currentIndex = 0;
            let isMobile = window.innerWidth <= 767;
            let activePreload: HTMLImageElement | null = null;
            let isInitialLoad = true;
            const images: ImageSchema[] = JSON.parse(
                galleryElement.dataset.images!,
            );

            const thumbnails = galleryElement.querySelectorAll(".thumbnail");
            const img: HTMLImageElement = galleryElement.querySelector(
                ".image-container img",
            ) as HTMLImageElement;
            const imgCaption: HTMLParagraphElement =
                galleryElement.querySelector(
                    ".caption-container .caption",
                ) as HTMLParagraphElement;

            function showImage(index: number) {
                if (index < 0 || index >= images.length) return;
                currentIndex = index;

                thumbnails.forEach((thumb, i) => {
                    thumb.classList.toggle("active", i === index);
                });

                if (activePreload) activePreload.onload = null;

                const { src, mobileVariant, alt, caption } = images[index];
                const newSrc = isMobile && mobileVariant ? mobileVariant : src;

                if (isInitialLoad) {
                    isInitialLoad = false;
                    img.src = newSrc;
                    img.alt = alt;
                    imgCaption.innerHTML = caption ?? "";
                    return;
                }

                const preload = new Image();
                activePreload = preload;

                let fadeComplete = false;
                let imageReady = false;

                function doSwap() {
                    if (activePreload !== preload) return;
                    img.src = newSrc;
                    img.alt = alt;
                    imgCaption.innerHTML = caption ?? "";
                    img.style.opacity = '';
                    activePreload = null;
                }

                setTimeout(() => {
                    fadeComplete = true;
                    if (imageReady) doSwap();
                }, 150);

                img.style.opacity = '0';

                preload.src = newSrc;
                if (preload.complete) {
                    imageReady = true;
                } else {
                    preload.onload = () => {
                        imageReady = true;
                        if (fadeComplete) doSwap();
                    };
                }
            }

            function nextImage() {
                const newIndex = (currentIndex + 1) % images.length;
                showImage(newIndex);
            }

            function prevImage() {
                const newIndex =
                    (currentIndex - 1 + images.length) % images.length;
                showImage(newIndex);
            }

            const dialog = galleryElement.closest('dialog');

            dialog?.addEventListener("toggle", () => {
                if (!(dialog as HTMLDialogElement).open) return;
                currentIndex = 0;
                isInitialLoad = true;
                const dialogTitle = dialog.querySelector(
                    `.gallery-title h2`,
                ) as HTMLElement;
                typewriter(dialogTitle, 0);
                showImage(currentIndex);
            });

            function triggerClose() {
                if ((dialog as HTMLElement).classList.contains('closing')) return;
                (dialog as HTMLElement).classList.add('closing');
                dialog?.addEventListener('animationend', () => {
                    (dialog as HTMLDialogElement).close();
                    (dialog as HTMLElement).classList.remove('closing');
                }, { once: true });
            }

            const closeBtn = dialog?.querySelector('.dialog-close') as HTMLButtonElement | null;
            if (closeBtn) {
                closeBtn.removeAttribute('command');
                closeBtn.removeAttribute('commandfor');
                closeBtn.addEventListener('click', triggerClose);
            }

            dialog?.addEventListener('cancel', (e) => {
                e.preventDefault();
                triggerClose();
            });

            dialog?.addEventListener("click", (e) => {
                if (e.target === dialog) triggerClose();
            });

            img.addEventListener("error", () => {
                img.alt = "Image failed to load";
                currentIndex = 0;
            });

            const prevBtn = gallery.querySelector(".prev");
            const nextBtn = gallery.querySelector(".next");
            prevBtn?.addEventListener("click", prevImage);
            nextBtn?.addEventListener("click", nextImage);

            thumbnails.forEach((thumb, index) => {
                thumb.addEventListener("click", () => showImage(index));
            });

            const controller = new AbortController();
            document.addEventListener("astro:before-swap", () => controller.abort(), { once: true });

            document.addEventListener("keydown", (e) => {
                if (!(dialog as HTMLDialogElement).open) return;
                if (e.key === "ArrowRight") nextImage();
                if (e.key === "ArrowLeft") prevImage();
            }, { signal: controller.signal });

            let touchStartX = 0;
            galleryElement.addEventListener("touchstart", (e) => {
                touchStartX = (e as TouchEvent).touches[0].clientX;
            }, { passive: true });
            galleryElement.addEventListener("touchend", (e) => {
                const diff = touchStartX - (e as TouchEvent).changedTouches[0].clientX;
                if (Math.abs(diff) > 40) diff > 0 ? nextImage() : prevImage();
            });

            window.addEventListener("resize", () => {
                isMobile = window.innerWidth <= 767;
            }, { signal: controller.signal });
        });
    });
</script>
