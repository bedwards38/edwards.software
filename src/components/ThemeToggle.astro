import { useTranslations } from "@utils/utils.ts";
import SunIcon from "@components/icons/SunIcon.astro";
import MoonIcon from "@components/icons/MoonIcon.astro";

const { locale = "en", ...props } = Astro.props;

const { t } = useTranslations(locale);
---

<div
    id="theme-toggle"
    aria-label={t("button.toggle.theme")}
    title={t("button.toggle.theme")}
    {...props}
>
    <SunIcon class="sun-icon" />
    <MoonIcon class="moon-icon" />
</div>

<style>
    #theme-toggle {
        cursor: pointer;
        transition: all 0.3s;
        color: var(--text);
    }

    #theme-toggle:hover {
        transform: translateY(-2px);
    }

    :root[data-theme="dark"] .moon-icon,
    :root[data-theme="light"] .sun-icon {
        display: none;
    }

    :root[data-theme="dark"] .sun-icon,
    :root[data-theme="light"] .moon-icon {
        display: block;
    }

    .sun-icon,
    .moon-icon {
        display: none;
    }

    @media (min-width: 880px) {
        #theme-toggle:hover {
            transform: translateY(-2px) scaleX(-1);
        }
    }
</style>
<script is:inline>
    /* Inline script to set the theme on page swap to avoid content flahses */
    function applyTheme() {
        const theme = !localStorage.theme
            ? "dark"
            : localStorage.theme === "light"
              ? "light"
              : "dark";

        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);
    }

    document.addEventListener("astro:after-swap", applyTheme);
    document.addEventListener("astro:page-load", applyTheme);
    applyTheme();
</script>

<script>
    document.addEventListener("astro:page-load", () => {
        const html = document.documentElement;

        function setTheme(theme: string) {
            html.setAttribute("data-theme", theme);
            localStorage.setItem("theme", theme);
        }

        const themeToggle = document.getElementById("theme-toggle");
        themeToggle?.addEventListener("click", () => {
            const currentTheme = html.dataset.theme;
            const newTheme = currentTheme === "dark" ? "light" : "dark";
            setTheme(newTheme);
        });

        window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", (e) => {
                if (!localStorage.getItem("theme")) {
                    setTheme(e.matches ? "dark" : "light");
                }
            });
    });
</script>
