import { env } from "cloudflare:workers";
import { useTranslations } from "@utils/utils.ts";
import GitHubIcon from "@icons/GitHubIcon.astro";
import LinkedInIcon from "@icons/LinkedInIcon.astro";

interface Props {
    locale?: string;
}

const { locale = "es" } = Astro.props;

const { t } = useTranslations(locale);

const currentYear = new Date().getFullYear();
---

<footer id="contact" class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-copyright">
                <span class="copyright mono">
                    {
                        t("footer.copyright")!.replace(
                            "{year}",
                            currentYear.toString(),
                        )
                    }
                </span>
            </div>
            <div class="footer-links">
                <div class="footer-email">
                    <button class="reveal-email mono" id="reveal-email">
                        {t("footer.contact")}
                    </button>
                    <div
                        class="email-display mono"
                        id="email-display"
                        style="display: none;"
                    >
                        <a
                            href={`mailto:${env.CONTACT_EMAIL}`}
                            class="email-link">{env.CONTACT_EMAIL}</a
                        >
                    </div>
                </div>
                <a
                    class="github-link"
                    href={env.GITHUB_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <GitHubIcon class="github-icon" />
                </a>
                <a
                    href={env.LINKEDIN_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <LinkedInIcon class="linkedin-icon" />
                </a>
            </div>
        </div>
    </div>

    <style>
        .footer {
            padding: 1rem 0 1rem 0;
            margin-top: auto;
        }

        .footer-content {
            padding-top: 2rem;
            border-top: 1px solid var(--border);
            font-size: clamp(0.7rem, 1.5vw, 0.8rem);
            opacity: 0.6;
            gap: 1rem;
            text-align: center;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 0.75rem;
            gap: 0.75rem;
        }

        .footer-links a {
            opacity: 0.7;
            transition: opacity 0.2s;
        }

        .footer-links a:hover {
            opacity: 1;
        }

        .footer-email {
            width: 100%;
            min-height: 2.5rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .reveal-email {
            background: transparent;
            border: 2px solid var(--border);
            border-radius: 0.3125rem;
            color: var(--text);
            padding: 0.5rem 1.25rem;
            cursor: pointer;
            transition: all 0.3s;
            font-family: var(--mono);
            font-size: clamp(0.75rem, 1.5vw, 0.85rem);
        }

        .reveal-email:hover {
            border-color: var(--text);
            transform: translateY(-2px);
        }

        .email-display {
            display: flex;
            justify-content: center;
            animation: fadeIn 0.5s ease-in;
        }

        .email-link {
            font-size: clamp(0.75rem, 1.5vw, 0.85rem);
            color: var(--text);
        }

        .github-icon,
        .linkedin-icon {
            color: var(--text);
        }

        @media (min-width: 880px) {
            .footer {
                padding: 2rem 0rem 2rem;
            }

            .footer-content {
                display: flex;
                justify-content: space-between;
            }

            .footer-copyright {
                display: flex;
                align-items: center;
            }

            .footer-links {
                align-items: end;
                min-height: 3rem;
                margin-top: unset;
                gap: 1rem;
            }

            .footer-email {
                width: auto;
                align-items: end;
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <script>
        document.addEventListener("astro:page-load", () => {
            const revealButton = document.getElementById("reveal-email")!;
            const emailDisplay = document.getElementById("email-display")!;

            revealButton.addEventListener("click", () => {
                revealButton.style.display = "none";
                emailDisplay.style.display = "flex";
            });
        });
    </script>
</footer>
