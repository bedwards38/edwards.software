import { useTranslations } from "@utils/utils.ts";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    filters: (string | null)[];
    filterCommand?: string;
    locale?: string;
}

const { filterCommand, filters, locale = "en", ...props } = Astro.props;

const { t } = useTranslations(locale);
---

<div id="toggle-container" {...props}>
    <button class="mono" id="filter-toggle">
        <span class="command">
            <span id="command-text">
                {filterCommand}<span id="filter-item"></span><span
                    class="cursor"></span>
            </span>
        </span>
    </button>
</div>
<div
    class="filter-container"
    id="filter-container"
    style="display: none;"
>
    <button class="filter-btn active mono" data-filter="all">
        {t("card.filter.all")}
    </button>
    {
        filters
            .filter((filter) => filter !== null)
            .sort((a, b) => a.localeCompare(b, locale, { sensitivity: "base" }))
            .map((filter) => (
                <button class="filter-btn mono" data-filter={filter}>
                    {filter}
                </button>
            ))
    }
</div>
<script>
    import { reverseTypewriter } from "@utils/utils";

    document.addEventListener("astro:page-load", () => {
        const filterContainer = document.getElementById("filter-container")!;
        const filterButtons = document.querySelectorAll(".filter-btn");
        const filterToggle = document.getElementById("filter-toggle")!;
        const filterItem = document.getElementById("filter-item")!;
        const cards = document.querySelectorAll(".card");

        filterToggle?.addEventListener("click", () => {
            const isVisible = filterContainer?.style.display !== "none";
            filterContainer.getAnimations().forEach((a) => a.cancel());

            if (!isVisible) {
                filterContainer.style.display = "grid";
                filterContainer.animate(
                    [
                        { opacity: 0, transform: "translateY(-12px) scale(0.96)" },
                        { opacity: 1, transform: "translateY(0) scale(1)" },
                    ],
                    { duration: 280, easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "backwards" },
                );
                filterToggle.classList.toggle("active");
                return;
            }

            const closeAnim = filterContainer.animate(
                [
                    { opacity: 1, transform: "translateY(0) scale(1)" },
                    { opacity: 0, transform: "translateY(-8px) scale(0.96)" },
                ],
                { duration: 180, easing: "cubic-bezier(0.4, 0, 1, 1)", fill: "forwards" },
            );
            closeAnim.onfinish = () => {
                filterContainer.style.display = "none";
                closeAnim.cancel();
            };
        });

        const EXIT_MS = 150;
        const GROW_MS = 380;
        const GROW_EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
        let filterTimeout: ReturnType<typeof setTimeout> | null = null;
        let fadeStripped = false;

        filterButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const filter = button.getAttribute("data-filter")!;

                if (filterTimeout !== null) {
                    clearTimeout(filterTimeout);
                    filterTimeout = null;
                    cards.forEach((card) => {
                        card.getAnimations().forEach((a) => a.cancel());
                        (card as HTMLElement).style.transformOrigin = "";
                    });
                }

                filterButtons.forEach((btn) => btn.classList.remove("active"));
                button.classList.add("active");
                filterItem.dataset.reverse = filterItem.innerText;
                filterItem.dataset.content = filter !== "all" ? filter : "";
                reverseTypewriter(filterItem, filterItem.innerText.length - 1);

                if (!fadeStripped) {
                    cards.forEach((card) => {
                        card.classList.remove("fade-in");
                        (card as HTMLElement).style.animationDelay = "0s";
                    });
                    fadeStripped = true;
                }

                const cardsToHide: Element[] = [];
                const cardsToStay: Element[] = [];
                const cardsToShow: Element[] = [];

                cards.forEach((card, index) => {
                    const isHidden = card.classList.contains("hidden");
                    const tags =
                        card.getAttribute("data-tags")?.split(",") || [];
                    const show = filter === "all" || tags.includes(filter);
                    if (!isHidden && !show) cardsToHide.push(card);
                    else if (!isHidden && show) cardsToStay.push(card);
                    else if (isHidden && show) cardsToShow.push(card);
                });

                if (cardsToHide.length === 0 && cardsToShow.length === 0) {
                    cardsToStay.forEach((card) => {
                        const cardEl = card as HTMLElement;
                        cardEl.style.transformOrigin = "center center";
                        const anim = card.animate(
                            [
                                { transform: "scale(1)" },
                                { transform: "scale(1.02)" },
                                { transform: "scale(1)" },
                            ],
                            { duration: 280, easing: "ease-in-out" },
                        );
                        anim.onfinish = () => {
                            cardEl.style.transformOrigin = "";
                        };
                    });
                    return;
                }

                const firstRects = new Map<Element, DOMRect>();
                cardsToStay.forEach((card) =>
                    firstRects.set(card, card.getBoundingClientRect()),
                );

                cardsToHide.forEach((card) =>
                    card.animate(
                        [
                            { opacity: 1, transform: "scale(1)" },
                            { opacity: 0, transform: "scale(0.88)" },
                        ],
                        {
                            duration: EXIT_MS,
                            easing: "ease-in",
                            fill: "forwards",
                        },
                    ),
                );

                filterTimeout = setTimeout(() => {
                    filterTimeout = null;

                    cards.forEach((card, index) => {
                        card.classList.remove("highlight");
                        if (filter === "all" && index === 0)
                            card.classList.add("highlight");
                    });
                    cardsToHide.forEach((card) => {
                        card.getAnimations().forEach((a) => a.cancel());
                        card.classList.add("hidden");
                    });
                    cardsToShow.forEach((card) =>
                        card.classList.remove("hidden"),
                    );

                    void document.body.offsetHeight;

                    cardsToStay.forEach((card) => {
                        const first = firstRects.get(card)!;
                        const last = card.getBoundingClientRect();
                        const scaleX = first.width / last.width;
                        const dx = first.left - last.left;
                        const cardEl = card as HTMLElement;
                        cardEl.style.transformOrigin = "left center";
                        const anim = card.animate(
                            [
                                {
                                    transform: `translateX(${dx}px) scaleX(${scaleX})`,
                                },
                                {
                                    transform: "translateX(0) scaleX(1)",
                                },
                            ],
                            { duration: GROW_MS, easing: GROW_EASE },
                        );
                        anim.onfinish = () => {
                            cardEl.style.transformOrigin = "";
                        };
                    });

                    cardsToShow.forEach((card) =>
                        card.animate(
                            [
                                {
                                    opacity: 0,
                                    transform: "scale(0.9) translateY(12px)",
                                },
                                {
                                    opacity: 1,
                                    transform: "scale(1) translateY(0)",
                                },
                            ],
                            {
                                duration: GROW_MS,
                                easing: GROW_EASE,
                                fill: "backwards",
                            },
                        ),
                    );
                }, EXIT_MS);
            });
        });
    });
</script>
<style>
    #toggle-container button {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: fit-content;
        color: var(--text);
        background: linear-gradient(
            135deg,
            transparent 0%,
            rgb(from var(--text) r g b / 2%) 100%
        );
        border: 1.25px solid var(--border);
        border-radius: 0.3125rem;
        padding: 0.75rem 1.5rem;
        cursor: pointer;
        transition: all 0.3s;
        font-family: var(--mono);
        font-size: clamp(0.8rem, 1.5vw, 0.95rem);
    }

    #toggle-container button:hover {
        color: var(--text);
        border-color: var(--earth);
        transform: translateY(-2px);
        background: linear-gradient(
            135deg,
            transparent 0%,
            rgb(from var(--text) r g b / 4%) 100%
        );
    }

    #toggle-container .command {
        display: flex;
    }

    #toggle-container .cursor {
        display: inline-block;
        opacity: 0.8;
    }

    .filter-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        grid-auto-rows: auto;
        gap: 0.5rem;
        padding: 1rem;
        margin: 1rem 0rem 0.5rem;
        border: 1px solid var(--border);
        border-radius: 0.3125rem;
        background: rgb(from var(--text) r g b / 2%);
        min-width: 100%;
    }

    .filter-btn {
        background: transparent;
        border: none;
        border-radius: 0.3125rem;
        color: var(--text);
        cursor: pointer;
        transition: all 0.2s;
        font-family: var(--mono);
        font-size: 0.8rem;
        padding: 0.4rem 0.5rem;
        opacity: 0.7;
        word-wrap: break-word;
        line-height: 1.3;
    }

    .filter-btn:hover {
        opacity: 1;
        background: rgb(from var(--text) r g b / 5%);
    }

    .filter-btn.active {
        opacity: 1;
        color: var(--text);
        background: rgb(from var(--earth) r g b / 12%);
    }

    @media (min-width: 768px) {
        #toggle-container {
            margin-bottom: 0.5rem;
        }
    }
</style>
