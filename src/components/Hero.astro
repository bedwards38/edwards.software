---
import { useTranslations } from "@utils/utils.ts";

interface Props {
    title: string;
    subtitle: string;
    description: string;
    featuredPaths: string[];
    locale?: string;
}

const {
    title,
    subtitle,
    description,
    featuredPaths,
    locale = "en",
} = Astro.props;

const { tArr } = useTranslations(locale);

const mainCTA = featuredPaths[0];
---

<div class="hero-content">
    <h1 class="typewriter cursor" data-content={title}></h1>
    <p class="subtitle mono">{subtitle}</p>
    <p class="description mono">{description}</p>
    <div class="cta">
        <a href={`/${locale}${mainCTA}`} class="btn-primary mono"
            >{tArr("hero.cta", 0)}</a
        >
        {
            featuredPaths.length > 1 &&
                featuredPaths.map(
                    (path, index) =>
                        path !== mainCTA && (
                            <a
                                href={`/${locale}${path}`}
                                class="btn-secondary mono"
                            >
                                {tArr(`hero.cta`, index)}
                            </a>
                        ),
                )
        }
    </div>
</div>
<style>
    h1 {
        margin-bottom: 1rem;
        width: fit-content;
        max-width: fit-content;
    }

    .subtitle {
        font-size: clamp(1.1rem, 3vw, 1.25rem);
        margin-bottom: 1.25rem;
        opacity: 0.8;
    }

    .description {
        display: block;
        font-size: 1rem;
        margin-top: 0.5rem;
        margin-bottom: 2rem;
        opacity: 0.6;
        font-style: italic;
    }

    .cta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        flex-direction: column;
    }

    .btn-primary,
    .btn-secondary {
        padding: 0.75rem 2rem;
        border-radius: 0.3125rem;
        transition: all 0.3s;
        display: inline-block;
        font-family: var(--mono);
        font-size: 0.9rem;
        text-align: center;
    }

    .btn-primary {
        background: var(--earth);
        border: 2px solid var(--earth);
        color: var(--bg);
    }

    .btn-primary:hover {
        background: var(--earth-hover);
        border-color: var(--earth-hover);
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: transparent;
        border: 2px solid var(--border);
        color: var(--text);
    }

    .btn-secondary:hover {
        background: linear-gradient(
            135deg,
            transparent 0%,
            rgb(from var(--text) r g b / 4%) 100%
        );
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    @media (min-width: 880px) {
        .hero-content {
            margin: 1rem 3rem 3rem;
        }

        .cta {
            flex-direction: unset;
        }

        .btn-primary,
        .btn-secondary {
            text-align: unset;
        }
    }
</style>
