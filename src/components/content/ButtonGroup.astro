---
import { getLocaleFromUrl, useTranslations } from "@utils/utils";
import ImageGallery from "@components/dialogs/GalleryDialog.astro";

const { link, repo, demo, images, galleryTitle, ...props } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const { t } = useTranslations(locale);

const normalizedTitle = galleryTitle
    ?.toLowerCase()
    .replace(/(-)+/g, "")
    .replace(/(\s)+|(\.)+/g, "-")
    .replace(/(\[)+|(\])+/g, "");
---

<div class="btn-group" {...props}>
    {
        images && (
            <button
                class="link-btn"
                command="show-modal"
                commandfor={`${normalizedTitle}-gallery`}
            >
                {t("explanation.button.images")}
            </button>
        )
    }
    {
        demo && (
            <button
                class="link-btn"
                onclick={`window.open('${demo}', '_blank')`}
            >
                {t("explanation.button.demo")}
            </button>
        )
    }
    {
        repo && (
            <button
                class="link-btn"
                onclick={`window.open('${repo}', '_blank')`}
            >
                {t("explanation.button.repo")}
            </button>
        )
    }
    {
        link && (
            <button
                class="link-btn"
                onclick={`window.open('${link}', '_blank')`}
            >
                {t("explanation.button.link")}
            </button>
        )
    }
</div>
{images && <ImageGallery images={images} title={galleryTitle!} />}

<style>
    .btn-group {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-bottom: 1rem;
        max-width: 100%;
    }

    .link-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        color: var(--text);
        background: transparent;
        border: 1.5px solid var(--border);
        border-radius: 0.3125rem;
        padding: 0.5rem 0.75rem;
        cursor: pointer;
        transition: all 0.3s;
        font-family: var(--mono);
        font-size: 0.85rem;
        font-weight: 575;
    }

    .link-btn:hover {
        border-color: var(--text);
        transform: translateY(-2px);
        background: linear-gradient(
            135deg,
            transparent 0%,
            rgb(from var(--text) r g b / 5%) 100%
        );
    }

    @media (min-width: 880px) {
        .btn-group {
            flex-direction: row;
            justify-content: end;
        }

        .link-btn {
            padding: 0.35rem 0.75rem;
            font-size: 0.85rem;
            width: fit-content;
        }
    }
</style>
