---
const props = Astro.props;

// The MDX compiler automatically puts blockquotes into <p> which causes issues when styling
// Remove the auto-rendered <p> so that custom styling can be applied
const html = (await Astro.slots.render("default")).replace(
    new RegExp("(<\/*p>)|(&lt;\/*p&gt;)", "g"),
    "",
);
---

<blockquote {...props}>
    <p class="blockquote-text" set:html={html} />
    <hr />
</blockquote>

<style>
    blockquote {
        background: rgb(from var(--accent) r g b / 10%);
        border-radius: 0.3125rem;
        text-align: center;
        padding: 0.5rem;
        margin-bottom: 1rem;
        font-style: italic;
        opacity: 0.7;
    }

    .blockquote-text:first-child {
        padding: 0.25rem;
        margin-bottom: 0.5rem;
    }
</style>
