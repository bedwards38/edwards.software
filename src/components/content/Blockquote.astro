---
const props = Astro.props;

// The MDX compiler automatically puts blockquotes into <p> which causes issues when styling
// Remove the auto-rendered <p> so that custom styling can be applied
const html = (await Astro.slots.render("default")).replace(
    new RegExp("(<\/*p>)|(&lt;\/*p&gt;)", "g"),
    "",
);
---

<blockquote {...props}>
    <p class="blockquote-text" set:html={html} />
    <hr />
</blockquote>

<style>
    blockquote {
        border-left: 2px solid var(--earth);
        background: rgb(from var(--earth) r g b / 8%);
        border-radius: 0 0.3125rem 0.3125rem 0;
        padding: 0.5rem 0.75rem 0.5rem 1rem;
        margin: 0.5rem auto 1.5rem;
        max-width: 100%;
        font-style: italic;
        opacity: 0.7;
        text-align: center;
    }

    .blockquote-text:first-child {
        margin-bottom: 0;
    }

    hr {
        display: none;
    }
</style>
